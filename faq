    </svg>
</div>
""", unsafe_allow_html=True)

# Barre de recherche et filtres
categories_list = ["Toutes les catégories", "GÉNÉRAL", "LES DOSSIERS", "LES VIDÉOS DU COURS", "LES FICHIERS", "LE GROUPE FACEBOOK", "ÉCHANGES ET COMMUNICATION", "LE COURS EN LIGNE", "ÉCOLE"]

selected_cat = st.radio("Filtrer par thème :", categories_list, horizontal=True)
search_term = st.text_input("⌕ Rechercher une question ou un mot-clé :", placeholder="ex: enregistrement, gmail, parking, zoom...")

st.divider()

# Filtrage des éléments
filtered_faq = []
for item in FAQ_DATA:
    cat_match = (selected_cat == "Toutes les catégories") or (item["category"] == selected_cat)
    search_text = f"{item['question']} {item['answer']}".lower()
    search_match = not search_term.strip() or (search_term.lower().strip() in search_text)
    
    if cat_match and search_match:
        filtered_faq.append(item)

# Affichage des résultats
if filtered_faq:
    st.caption(f"**{len(filtered_faq)}** question(s) trouvée(s)")
    for idx, item in enumerate(filtered_faq):
        cat_color = CATEGORY_COLORS.get(item["category"], "#64748B")
        
        with st.container():
            st.markdown(f'<span class="cat-badge" style="background-color:{cat_color};">{item["category"]}</span>', unsafe_allow_html=True)
            with st.expander(f"**{item['question']}**"):
                st.markdown(item["answer"])
else:
    st.info("Aucune question ne correspond à votre recherche.")

# Pied de page
st.markdown("""
