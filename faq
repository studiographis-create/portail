            { cat: "LE GROUPE FACEBOOK", q: "Puis-je publier mes travaux ou poser des questions ?", a: "Oui ! C'est même le moyen idéal pour poser des questions sur le cours et partager vos travaux[cite: 1]." },

            { cat: "ÉCHANGES ET COMMUNICATION", q: "Quelle est ton adresse mail ?", a: "graphisstudio@me.com (ou studiographis@yahoo.fr en cas de problème)[cite: 1]." },
            { cat: "ÉCHANGES ET COMMUNICATION", q: "J'ai une question en dehors du cours, par quel moyen la poser ?", a: "1. Le groupe Facebook si cela concerne tout le monde. 2. Mail. 3. Messenger (Damblon Dimitri). 4. WhatsApp[cite: 1]." },

            { cat: "LE COURS EN LIGNE", q: "Comment accéder au cours en ligne ?", a: "Le lien est disponible sur la page du portail : <a href='https://studiographis-create.github.io/portail/index.html' target='_blank'>Portail</a>[cite: 1]." },
            { cat: "LE COURS EN LIGNE", q: "Dois-je activer ma vidéo ou mon micro ?", a: "Non, la vidéo n'est pas obligatoire. Il est même mieux de couper le micro et de le rallumer en cas de question[cite: 1]." },

            { cat: "ÉCOLE", q: "Quel est le mot de passe du wifi à l'école ?", a: "Il n'y a actuellement pas de wifi à l'école[cite: 1]." },
            { cat: "ÉCOLE", q: "Où puis-je me garer à l'école (Philippeville) ?", a: "Sur le parking de l'école ou Rue de la Roche (4 roues sur la route, pas sur le trottoir). Ne pas se garer sur les emplacements de la menuiserie[cite: 1]." }
        ];

        const catColors = {
            "GÉNÉRAL": "#38BDF8",
            "LES DOSSIERS": "#8B5CF6",
            "LES VIDÉOS DU COURS": "#E11D48",
            "LES FICHIERS": "#F59E0B",
            "LE GROUPE FACEBOOK": "#2563EB",
            "ÉCHANGES ET COMMUNICATION": "#10B981",
            "LE COURS EN LIGNE": "#EC4899",
            "ÉCOLE": "#A855F7"
        };

        let currentCategory = 'TOUT';

        function renderFAQ(items) {
            const listContainer = document.getElementById('faqList');
            if (items.length === 0) {
                listContainer.innerHTML = '<p style="text-align: center; color: #94a3b8;">Aucune question ne correspond à votre recherche.</p>';
                return;
            }
            
            listContainer.innerHTML = items.map(item => {
                const color = catColors[item.cat] || '#64748B';
                return `
                    <div class="faq-card">
                        <span class="cat-badge" style="background-color: ${color};">${item.cat}</span>
                        <details>
                            <summary>${item.q}</summary>
                            <div class="faq-content">${item.a}</div>
                        </details>
                    </div>
                `;
            }).join('');
        }

        function filterFAQ() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const filtered = faqData.filter(item => {
                const matchesCat = (currentCategory === 'TOUT' || item.cat === currentCategory);
                const matchesSearch = item.q.toLowerCase().includes(searchTerm) || item.a.toLowerCase().includes(searchTerm);
                return matchesCat && matchesSearch;
            });
            renderFAQ(filtered);
        }

        function filterCategory(category, btn) {
            currentCategory = category;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filterFAQ();
        }

        // Affichage initial au chargement de la page
        renderFAQ(faqData);
    </script>
</body>
</html>
