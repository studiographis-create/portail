            { cat: "GÉNÉRAL", q: "Qui est concerné par la FAQ ?", a: "Les élèves de Photoshop et Lightroom 1 et 2 de Philippeville et Thuin ainsi que Photoshop artistique[cite: 1]." },
            { cat: "GÉNÉRAL", q: "Où trouver la FAQ ?", a: "Elle est disponible dans votre dossier « classe » (ex: Photoshop et Lightroom Philippeville)[cite: 1]." },
            { cat: "GÉNÉRAL", q: "Comment trouver l'information dans le PDF ?", a: "Faites CTRL/Cmd + F ou Édition > Rechercher dans Adobe Acrobat Reader[cite: 1]." },
            { cat: "GÉNÉRAL", q: "Vous avez une question qui n'est pas dans la FAQ ?", a: "Envoyez-moi un mail à <a href='mailto:graphisstudio@me.com'>graphisstudio@me.com</a> et je me ferai un plaisir de l'ajouter[cite: 1]." },
            
            { cat: "LES DOSSIERS", q: "J'ai accès à combien de dossier(s) partagé(s) ?", a: "Vous avez un dossier par classe et un second dossier pour le support Photoshop[cite: 1]." },
            { cat: "LES DOSSIERS", q: "Comment se nomme le dossier de ma classe ?", a: "Photoshop et Lightroom Thuin, Photoshop et Lightroom (Philippeville), Photoshop et Lightroom 2, Photoshop artistique Philippeville[cite: 1]." },
            { cat: "LES DOSSIERS", q: "Comment accéder aux dossiers ?", a: "Via le lien reçu par mail ou sur le portail : <a href='https://studiographis-create.github.io/portail/index.html' target='_blank'>Portail des cours</a>[cite: 1]." },
            { cat: "LES DOSSIERS", q: "Je ne vois pas le contenu d'un dossier", a: "Rafraîchissez la page, redémarrez le navigateur, testez avec Google Chrome, ou téléchargez l'application Google Drive[cite: 1]." },

            { cat: "LES VIDÉOS DU COURS", q: "Où sont les vidéos de mon cours ?", a: "Dans votre dossier par classe > dossier « vidéos du cours »[cite: 1]." },
            { cat: "LES VIDÉOS DU COURS", q: "À partir de quand la vidéo est-elle disponible ?", a: "Au mieux le lendemain du cours, au pire dans la semaine. Un signalement est fait sur le groupe Facebook[cite: 1]." },
            { cat: "LES VIDÉOS DU COURS", q: "Puis-je télécharger une vidéo du cours ?", a: "Oui, en cliquant sur la flèche en haut à gauche de la vidéo ou en utilisant « Tout télécharger »[cite: 1]." },

            { cat: "LES FICHIERS", q: "Comment télécharger un fichier (PDF, HTML, Jpg, Raw,...) ?", a: "Passez le curseur sur celui-ci et une flèche de téléchargement apparaîtra[cite: 1]." },
            { cat: "LES FICHIERS", q: "Quand je télécharge des fichiers, ils ont l'extension .RAR", a: "C'est normal, Google Drive compresse les fichiers avant de les télécharger. Vous devez les décompresser (ex: avec WinRAR ou WinZip)[cite: 1]." },
            { cat: "LES FICHIERS", q: "De quels fichiers ai-je besoin en classe ?", a: "Uniquement tous les fichiers du dossier « photos pour le cours » (de préférence sur clé USB ou PC portable)[cite: 1]." },

